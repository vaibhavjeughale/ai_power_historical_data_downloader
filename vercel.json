{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "src": "/(.*)",
      "destination": "/dist/$1"
    }
  ]
}